<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hourly bounty guard for lizTheDeveloper/privacy-the-game. Runs on this Mac
  (never on a CI runner) using the gh CLI's stored login. Template: install.sh
  fills in __NODE__, __DIR__ and __LOG__ and copies it to ~/Library/LaunchAgents.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.multiverse.bounty-guard</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__DIR__/guard.mjs</string>
    <string>--apply</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>BOUNTY_GUARD_LOG</key>
    <string>__LOG__</string>
  </dict>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
</dict>
</plist>
